# AI Providers
# Copy this file to .env and fill in your values — NEVER commit .env
GEMINI_API_KEY=AIzaSy...
GROK_API_KEY=xai-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# NOTE: user credentials (vault) are stored in the OS keychain via keytar — NOT here

# Telemetry (opt-in)
TELEMETRY_ENDPOINT=https://...
TELEMETRY_API_KEY=...

# Local model (addon)
WHISPER_LOCAL_PATH=C:\tools\whisper.cpp\main.exe
WHISPER_LOCAL_MODEL=ggml-base.en.bin
