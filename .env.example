# ── AI Providers ─────────────────────────────────────────────────────────────
# Set at least ONE of the following for voice transcription.
# voice.provider config (app.config.json) selects which one to use:
#   gemini | openai | grok | claude | local

GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ── Telemetry (opt-in) ────────────────────────────────────────────────────────
TELEMETRY_ENDPOINT=
TELEMETRY_API_KEY=

# ── Local Whisper (addon — Phase 6) ──────────────────────────────────────────
WHISPER_LOCAL_PATH=
WHISPER_LOCAL_MODEL=

# ── Notes ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env — it is in .gitignore.
# User credentials (vault) are stored in the OS keychain via keytar, NOT here.
